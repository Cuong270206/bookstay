# ===== Database =====
DATABASE_URL=postgresql://bookstay:bookstay_dev_password@localhost:5432/bookstay

# ===== Redis (for booking locks & caching) =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# Production: chuỗi ngẫu nhiên >= 32 ký tự (vd: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===== App =====
NODE_ENV=development
PORT=3001
# Nhiều origin cách nhau bằng dấu phẩy
FRONTEND_URL=http://localhost:3000

# ===== Rate limiting =====
# Số giây trong cửa sổ / số request tối đa mỗi IP
THROTTLER_TTL=60
THROTTLER_LIMIT=100

# ===== Swagger =====
# Mặc định tắt ở production; đặt true nếu cần mở
SWAGGER_ENABLED=false

# ===== Admin seed (npm run db:seed) =====
ADMIN_EMAIL=admin@bookstay.vn
ADMIN_PASSWORD=Admin@123456

# ===== VNPay =====
# Đăng ký merchant: https://sandbox.vnpayment.vn/devreg/ (sandbox) hoặc vnpayment.vn (production)
# VNPAY_URL production: https://pay.vnpay.vn/vpcpay.html (đăng ký URL với VNPay)
# VNPAY_RETURN_URL phải là URL PUBLIC của BACKEND (VNPay redirect trình duyệt về đây),
# backend sẽ verify chữ ký rồi chuyển tiếp về FRONTEND_URL
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/api/v1/payments/vnpay-return

# ===== Cloudinary (for image uploads) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
